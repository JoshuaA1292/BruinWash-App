# Supabase — from the existing CampusWash Supabase project
# Settings -> API. The publishable/anon key is safe to ship in the client.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Stripe publishable key (pk_test_... / pk_live_...). Safe to ship in the client.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY

# ---------------------------------------------------------------------------
# SERVER-ONLY — set these as Supabase Edge Function secrets, never here:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
#   supabase secrets set EXPO_ACCESS_TOKEN=...       # optional, for Expo Push security
#   supabase secrets set ADMIN_EMAIL=you@example.com
#   supabase secrets set RESEND_API_KEY=...          # optional, admin email alerts
# ---------------------------------------------------------------------------
