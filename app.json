{
  "expo": {
    "name": "BruinWash",
    "slug": "bruinwash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bruinwash",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#005581",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#005581"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.campuswash.bruinwash",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "BruinWash uses your camera so washers can take a photo confirming laundry was delivered.",
        "NSPhotoLibraryUsageDescription": "BruinWash lets you attach a delivery photo or profile picture from your photo library.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "app.campuswash.bruinwash",
      "adaptiveIcon": {
        "backgroundColor": "#005581",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "POST_NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-font",
      "expo-image",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#005581"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BruinWash lets you attach a delivery photo or profile picture from your photo library.",
          "cameraPermission": "BruinWash uses your camera so washers can take a photo confirming laundry was delivered."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.app.campuswash.bruinwash",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
