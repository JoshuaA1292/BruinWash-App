{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    // Edge Functions run on Deno, not React Native: they import by URL and use
    // the Deno global, neither of which this config understands. They are
    // typechecked separately with `npm run typecheck:functions` (deno check).
    "supabase/functions"
  ]
}
